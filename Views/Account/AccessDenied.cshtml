@{
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
</head>
<body class="bg-gray-900 d-flex align-items-center justify-content-center min-vh-100">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6">
                <div class="card o-hidden border-0 shadow-lg my-5 mx-auto">
                    <div class="card-body text-center p-4 p-md-5">
                        <h1 class="h3 text-danger mb-3">Access Denied</h1>
                        <p class="text-gray-700 mb-4">
                            You do not have permission to access this page.
                        </p>
                        <a asp-action="Login"
                           asp-controller="Account"
                           class="btn btn-secondary btn-user">
                            Go to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/bootstrap.bundle.min.js"></script>
</body>
</html>
