@model CloseFriendMyanamr.ViewModel.RegisterViewModel

<meta name="viewport" content="width=device-width, initial-scale=1">

<body class="bg-gray-900 d-flex align-items-center justify-content-center min-vh-100">

    <div class="container">
        <div class="row justify-content-center">

            <div class="col-12 col-sm-10 col-md-9 col-lg-8 col-xl-10">

                <div class="card o-hidden border-0 shadow-lg my-5 login-card mx-auto">
                    <div class="card-body p-0">

                        <div class="row">
                            <div class="col-lg-12">

                                <img class="w-100 img-fluid" src="@Url.Content("~/images/Logo2.jpg")" alt="Logo">

                                <div class="p-3 p-md-5">

                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Create Account</h1>
                                    </div>

                                    <form asp-action="Register" method="post" class="user">

                                        <div class="form-group">
                                            <input asp-for="FullName" class="form-control form-control-user"
                                                placeholder="Full Name" />
                                            <span asp-validation-for="FullName" class="text-danger small"></span>
                                        </div>

                                        <div class="form-group">
                                            <input asp-for="PhoneNumber" class="form-control form-control-user"
                                                placeholder="Phone Number" />
                                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                        </div>

                                        <div class="form-group">
                                            <input asp-for="Address" class="form-control form-control-user"
                                                placeholder="Address" />
                                            <span asp-validation-for="Address" class="text-danger small"></span>
                                        </div>

                                        <div class="form-group">
                                            <input asp-for="Password" class="form-control form-control-user"
                                                placeholder="Password" />
                                            <span asp-validation-for="Password" class="text-danger small"></span>
                                        </div>

                                        <div class="form-group">
                                            <input asp-for="ConfirmPassword" class="form-control form-control-user"
                                                placeholder="Confirm Password" />
                                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                        </div>

                                        <button type="submit" class="btn btn-secondary btn-user btn-block">
                                            Register
                                        </button>

                                        <hr>

                                        <div class="text-center">
                                            <a asp-action="Login" class="small">
                                                Already have an account? Login!
                                            </a>
                                        </div>

                                    </form>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>

</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}