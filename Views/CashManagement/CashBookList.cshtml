@model IEnumerable<CloseFriendMyanamr.ViewModel.DateBalanceModel>

@{
    ViewData["Title"] = "Cash Book";
    DateTime fromDate = ViewBag.FromDate ?? DateTime.Today;
    DateTime toDate = ViewBag.ToDate ?? DateTime.Today;
}

<div class="row">
    <div class="col-sm-12">
        <div class="row">
            <form asp-action="CashBookList" method="get">
                <div class="row my-2">
                    <div class="col-md-3">
                        <label for="fromDate">From</label>
                        <input type="date" class="form-control" id="fromDate" name="fromDate" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" placeholder="From" />
                    </div>
                    <div class="col-md-3">
                        <label for="toDate">To</label>
                        <input type="date" class="form-control" id="toDate" name="toDate" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" placeholder="To" />
                    </div>
                    <div class="col-md-6 mt-3">
                        <button type="submit" class="btn btn-secondary form-btn mt-2">Search</button>
                        <a class="btn btn-info text-white mt-2 form-btn" asp-action="CompanyIncome" asp-controller="CashManagement">New Income</a>
                        <a class="btn btn-warning text-white mt-2 form-btn" asp-action="CompanyExpense" asp-controller="CashManagement">New Expense</a>
                        <a class="btn btn-secondary form-btn mt-2" asp-action="AccountTransfer" asp-controller="CashManagement">New Transfer</a>
                    </div>
                </div>
            </form>
        </div>

        <div class="row mt-4">
            <div class="col-md-12 mb-4">
                <div class="card border-2 shadow-sm">
                    <div class="card-header">
                        <span class="text-primary fw-bold">Cash Book</span>
                    </div>
                    <div class="card-body">
                        @if (fromDate == toDate)
                        {
                            <span class="text-primary fw-bold" style="font-size:14px; display:block; text-align:center;">
                                @fromDate.ToString("MMM dd, yyyy (dddd)")
                            </span>
                        }
                        else
                        {
                            <span class="text-primary fw-bold" style="font-size:14px; display:block; text-align:center;">
                                @fromDate.ToString("MMM dd, yyyy (dddd)") - @toDate.ToString("MMM dd, yyyy (dddd)")
                            </span>
                        }

                        <div class="table-responsive mt-3">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="bg-secondary text-white">
                                    <tr>
                                        <th class="text-center">Date</th>
                                        <th class="text-center">Opening Cash</th>
                                        <th class="text-center">Closing Cash</th>
                                        <th class="text-center">Opening Bank</th>
                                        <th class="text-center">Closing Bank</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var balance in Model)
                                        {
                                            <tr class="bg-light">
                                                <td class="text-center">@balance.Date.ToString("MMM dd, yyyy")</td>
                                                <td class="text-end">@balance.CashOpeningBalance.ToString("N0")</td>
                                                <td class="text-end">@balance.CashClosingBalance.ToString("N0")</td>
                                                <td class="text-end">@balance.BankOpeningBalance.ToString("N0")</td>
                                                <td class="text-end">@balance.BankClosingBalance.ToString("N0")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">No cash book records found for the selected period.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
