@model CloseFriendMyanamr.ViewModel.AccountTransferViewModel

@{
    ViewData["Title"] = "Account Transfer";
}

<div class="row my-3 mx-auto">
    <div class="col-sm-12">
        <h3 class="responsive-heading mb-3 text-center">Add Account Transfer Data</h3>
        <form asp-action="AccountTransfer" method="post" id="employeeForm">
            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>
            <div class="row">
                <div class="col-md-12 col-sm-12">
                    <div class="card mx-auto w-80 shadow">
                        <div class="card-header">
                            <span class="text-primary fw-bold">Account Transfer</span>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="TransactionDate"></label>
                                <input type="date" asp-for="TransactionDate" class="form-control" />
                                <span asp-validation-for="TransactionDate" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Amount"></label>
                                <input type="number" asp-for="Amount" class="form-control" min="1" step="1" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="FromAccount"></label>
                                <select class="form-select" asp-for="FromAccount">
                                    <option value="Cash">Main Cash</option>
                                    <option value="APM AYA Bank">APM AYA Bank</option>
                                </select>
                                <span asp-validation-for="FromAccount" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="ToAccount"></label>
                                <select class="form-select" asp-for="ToAccount">
                                    <option value="APM AYA Bank">APM AYA Bank</option>
                                    <option value="Cash">Main Cash</option>
                                </select>
                                <span asp-validation-for="ToAccount" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Description"></label>
                                <input asp-for="Description" class="form-control" placeholder="Type here" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary mt-3 text-center">Submit</button>
                <a asp-action="CashBookList" asp-controller="CashManagement" class="btn btn-secondary mt-3 text-center">Back To Cash Book</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
