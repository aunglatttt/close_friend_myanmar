@model IEnumerable<CloseFriendMyanamr.Models.CashManagement.CompanyIncomeModel>

@{
    ViewData["Title"] = "Company Income List";
}

<link rel="stylesheet" href="~/css/employeelist.css" asp-append-version="true" />

<div class="row">
    <div class="col-sm-12">
        <div class="row">
            <div class="col-md-12 mb-4 mt-2">
                <div class="card border-2 shadow">
                    <div class="card-header">
                        <span class="text-primary fw-bold">Income List</span>
                        <form asp-action="IncomeList" method="get">
                            <div class="row my-2">
                                <div class="col-md-2">
                                    <label for="fromDate" class="form-label">From</label>
                                    <input type="date" class="form-control" id="fromDate" name="fromDate" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" placeholder="From" />
                                </div>
                                <div class="col-md-2">
                                    <label for="toDate" class="form-label">To</label>
                                    <input type="date" class="form-control" id="toDate" name="toDate" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" placeholder="To" />
                                </div>
                                <div class="col-md-2">
                                    <label for="incomeTitleId" class="form-label">Income Title</label>
                                    <select class="form-select" id="incomeTitleId" name="incomeTitleId" asp-items="ViewBag.IncomeTitle">
                                        <option value="">All</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mt-4">
                                    <button type="submit" class="btn btn-secondary form-btn mt-2">Search</button>
                                    <a class="btn btn-secondary form-btn mt-2" asp-action="AccountTransfer" asp-controller="CashManagement">Account Transfer</a>
                                    <a class="btn btn-warning text-white mt-2 form-btn" asp-action="CompanyIncome" asp-controller="CashManagement">New Income</a>
                                    <a class="btn btn-primary form-btn mt-2" asp-action="CashBookList" asp-controller="CashManagement">Cash Book</a>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="incomeTable" class="table table-hover table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Income Title</th>
                                        <th>Income Type</th>
                                        <th>Amount</th>
                                        <th>Description</th>
                                        <th>Created At</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.IncomeDate.ToString("MMM dd, yyyy")</td>
                                                <td>@item.IncomeTitleName</td>
                                                <td>@item.IncomeType</td>
                                                <td class="text-end">@item.Amount.ToString("N0")</td>
                                                <td>@item.Remark</td>
                                                <td>@(item.CreatedAt != null ? item.CreatedAt.Value.ToString("MMM dd, yyyy  hh:mm tt") : "")</td>
                                                <td class="text-center">
                                                    <a class="btn btn-sm btn-outline-primary" asp-action="CompanyIncome" asp-controller="CashManagement" asp-route-id="@item.Id">Edit</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted">No income records found for the selected filters.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#incomeTable').DataTable({
            responsive: true,
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            autoWidth: false,
            lengthMenu: [
                [25, 50, 100, -1],
                [25, 50, 100, 'All']
            ],
            columnDefs: [
                { responsivePriority: 1, targets: 0 },
                { responsivePriority: 2, targets: -1 }
            ]
        });
    });
</script>
